{
  "name": "@denkwerk/favicon-generator",
  "version": "0.1.3",
  "description": "Generate favicons, touch icons, a web app manifest and browserconfig.xml from an SVG or a Figma node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denkwerk/favicon-generator.git",
    "directory": "packages/favicon-generator"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "favicon-generator": "bin/favicon-generator.js"
  },
  "files": [
    "bin",
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
