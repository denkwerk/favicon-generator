{
  "name": "@denkwerk/favicon-generator",
  "version": "0.2.4",
  "description": "Generate favicons, touch icons, a web app manifest and browserconfig.xml from an SVG or a Figma node. CLI and Node.js API; also available as a Nuxt module and a Vite, Rollup, Rolldown, webpack and Rspack plugin",
  "license": "MIT",
  "author": "denkwerk GmbH (https://denkwerk.com)",
  "homepage": "https://github.com/denkwerk/favicon-generator/tree/main/packages/favicon-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denkwerk/favicon-generator.git",
    "directory": "packages/favicon-generator"
  },
  "bugs": {
    "url": "https://github.com/denkwerk/favicon-generator/issues"
  },
  "keywords": [
    "favicon",
    "favicon-generator",
    "favicons",
    "favicon.ico",
    "apple-touch-icon",
    "web-app-manifest",
    "manifest",
    "pwa",
    "svg",
    "figma",
    "icons",
    "cli",
    "rust",
    "generator",
    "browserconfig",
    "head-tags",
    "nuxt",
    "nuxt-module",
    "vite",
    "vite-plugin",
    "rollup",
    "rollup-plugin",
    "rolldown",
    "rolldown-plugin",
    "tsdown",
    "webpack",
    "webpack-plugin",
    "rspack",
    "rspack-plugin",
    "unplugin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "favicon-generator": "bin/favicon-generator.js"
  },
  "files": [
    "bin",
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
