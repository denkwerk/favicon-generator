{
  "name": "@denkwerk/unplugin-favicon-generator",
  "version": "0.2.5",
  "description": "Vite, Rollup, Rolldown, webpack and Rspack plugin that generates favicons, touch icons and a web app manifest from an SVG or a Figma node, and adds the head tags",
  "license": "MIT",
  "author": "denkwerk GmbH (https://denkwerk.com)",
  "homepage": "https://github.com/denkwerk/favicon-generator/tree/main/packages/unplugin-favicon-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denkwerk/favicon-generator.git",
    "directory": "packages/unplugin-favicon-generator"
  },
  "bugs": {
    "url": "https://github.com/denkwerk/favicon-generator/issues"
  },
  "keywords": [
    "favicon",
    "favicon-generator",
    "favicons",
    "favicon.ico",
    "apple-touch-icon",
    "web-app-manifest",
    "manifest",
    "pwa",
    "svg",
    "figma",
    "icons",
    "unplugin",
    "vite",
    "vite-plugin",
    "rollup",
    "rollup-plugin",
    "rolldown",
    "rolldown-plugin",
    "tsdown",
    "webpack",
    "webpack-plugin",
    "rspack",
    "rspack-plugin",
    "nuxt",
    "nuxt-module"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "default": "./dist/rolldown.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite.d.ts"
      ],
      "rollup": [
        "./dist/rollup.d.ts"
      ],
      "rolldown": [
        "./dist/rolldown.d.ts"
      ],
      "webpack": [
        "./dist/webpack.d.ts"
      ],
      "rspack": [
        "./dist/rspack.d.ts"
      ],
      "client": [
        "./client.d.ts"
      ]
    }
  },
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "dependencies": {
    "@denkwerk/favicon-generator": "workspace:^",
    "unplugin": "^3.4.0"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0",
    "rolldown": ">=1.0.0",
    "rollup": ">=3.0.0",
    "vite": ">=6.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rspack/core": "^2.2.7",
    "@types/node": "^24.13.6",
    "rolldown": "^1.2.10",
    "rollup": "^4.63.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "webpack": "^5.111.1"
  }
}
