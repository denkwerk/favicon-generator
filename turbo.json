{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@denkwerk/favicon-generator#build": {
      "dependsOn": ["favicon-generator#build"],
      "outputs": ["dist/**"]
    },
    "@denkwerk/nuxt-favicon-generator#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "example-nuxt#build": {
      "dependsOn": ["^build"],
      "env": ["NUXT_APP_BASE_URL"],
      "outputs": [".output/**"]
    },
    "example-nuxt#test": {
      "dependsOn": ["build"]
    },
    "example-nuxt-config-file#build": {
      "dependsOn": ["^build"],
      "env": ["NUXT_APP_BASE_URL"],
      "outputs": [".output/**"]
    },
    "example-nuxt-config-file#test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "check": {},
    "format": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "example-cli-figma#generate": {
      "dependsOn": ["^build"],
      "env": ["FIGMA_TOKEN"],
      "cache": false
    }
  }
}
